
<!-- Shared header and navigation -->
<%- include('Partials/header.ejs') %>
<%- include('Partials/main_nav.ejs') %>

<div class="container my-4">

  <h1>Buy a Car</h1>

  <p>
    Interested in buying a car? Fill out the form below
    and let us know which vehicle you would like.
  </p>

  <form action="/buy_car" method="POST">

    <!-- Select a car -->
    <div class="mb-3">
      <label for="car" class="form-label">Choose a Car</label>
      <select class="form-select" id="car" name="car" required>
        <option value="">Select a vehicle</option>
        <option value="Toyota Corolla 2018">2018 Toyota Corolla - $14,500</option>
        <option value="Honda Civic 2020">2020 Honda Civic - $21,900</option>
        <option value="Ford F-150 2015">2015 Ford F-150 - $17,000</option>
      </select>
    </div>

    <!-- Buyer name -->
    <div class="mb-3">
      <label for="name" class="form-label">Full Name</label>
      <input type="text" class="form-control"
             id="name" name="name" required>
    </div>

    <!-- Buyer email -->
    <div class="mb-3">
      <label for="email" class="form-label">Email Address</label>
      <input type="email" class="form-control"
             id="email" name="email" required>
    </div>

    <!-- Buyer phone number -->
    <div class="mb-3">
      <label for="phone" class="form-label">Phone Number</label>
      <input type="tel" class="form-control"
             id="phone" name="phone">
    </div>

    <!-- Message -->
    <div class="mb-3">
      <label for="message" class="form-label">Message</label>
      <textarea class="form-control" id="message"
                name="message" rows="3"
                placeholder="Any questions about the car?"></textarea>
    </div>

    <button type="submit" class="btn btn-success">
      Submit Inquiry
    </button>

    <a href="/" class="btn btn-secondary">Back to Home</a>

  </form>

</div>

<!-- Shared footer -->
<%- include('Partials/footer.ejs') %>